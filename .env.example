# Recommended: python3 scripts/configure.py share.example.com
SHARE_DOMAIN=share.example.com
ACCESS_KEY=replace-with-a-long-private-passphrase
MAX_PARTICIPANTS=6
MAX_ROOMS=200
ROOM_TTL_SECONDS=21600
IDLE_TTL_SECONDS=1800
STUN_URLS=stun:stun.cloudflare.com:3478

# Optional: configure ALL TURN values together, or leave ALL empty.
TURN_URLS=
TURN_SECRET=
TURN_DOMAIN=
TURN_PUBLIC_IP=
RELAY_ONLY=false
